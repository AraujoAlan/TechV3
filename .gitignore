# Segredos
.env
.env.local
clinical_demo.db

# Dados derivados do MedPT (interacao real paciente-medico, nao versionar)
data/
*.parquet
*.jsonl
notebooks/*.json

# Excecao: a amostra publicada no repositorio e entregavel da fase.
# Funciona porque dataset_exemplo/ nao esta dentro de diretorio ignorado --
# negacao sob diretorio excluido (como data/) seria inerte.
!dataset_exemplo/*.jsonl

# Excecao: o banco que a aplicacao consulta. Dado 100% sintetico, gerado pelo
# 07 a partir de distribuicoes do SIH/SUS -- nenhum paciente real. Versionado
# porque o docker compose sobe sem reexecutar o pipeline.
!dados_hospital/*.parquet

# Artefatos de treino: pesos, checkpoints e cache do unsloth
modelos/
outputs/
unsloth_compiled_cache/
llama.cpp/
*.gguf
*.safetensors

# Auditoria e alertas gerados em execucao
logs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Ferramentas
.idea/
.vscode/
.ruff_cache/
.pytest_cache/

# Configurações de ambiente

# OpenAI (apenas para desenvolvimento inicial)
OPENAI_API_KEY=sua_chave_aqui

# Quando usar modelo fine-tuned local, não precisará de API key
# Configure conforme seu ambiente:

# Para Ollama
# OLLAMA_BASE_URL=http://localhost:11434

# Para HuggingFace
# HF_TOKEN=seu_token_aqui

# Para API customizada
# CUSTOM_MODEL_URL=http://localhost:5000/api

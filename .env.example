# Copie este arquivo para .env e substitua somente os valores à direita.
# Nunca versione o arquivo .env.

# --- Roteador: decide quais ferramentas chamar --------------------------------
# Única chave obrigatória. É o modelo que lê a pergunta e escolhe as consultas.
Z_API_KEY=sua_chave_z_ai
# Opcionais: os padrões abaixo são os que o grupo usa.
ROTEADOR_BASE_URL=https://api.z.ai/api/paas/v4/
ROTEADOR_MODELO=glm-5.3-flash
# Teto de chamadas de ferramenta por turno, para o agente não entrar em laço.
ROTEADOR_MAX_PASSOS=6

# --- Redator: o modelo fine-tunado, escreve a resposta ------------------------
# Aponta para o llama-server, que expõe API compatível com a da OpenAI. No
# compose o serviço se chama `redator`; fora dele, use localhost.
REDATOR_BASE_URL=http://localhost:8080/v1
REDATOR_MODELO=assistente-maternidade
REDATOR_TEMPERATURA=0.3
REDATOR_MAX_TOKENS=800

# --- Banco --------------------------------------------------------------------
# Teto de linhas por consulta. Protege a janela de contexto do redator: 500
# linhas de prontuário estouram o prompt.
MAX_LINHAS_CONSULTA=20

# --- Validação da resposta ----------------------------------------------------
# Quantas vezes o grafo pode mandar reescrever uma resposta reprovada. Com
# revisão ligada os tokens param de ir à tela enquanto são gerados, porque um
# rascunho ainda pode ser descartado; zero mantém a digitação ao vivo.
MAX_REVISOES=0

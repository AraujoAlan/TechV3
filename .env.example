# Copie este arquivo para .env e substitua somente os valores à direita.
# Nunca versione o arquivo .env.

# Obrigatória para o GeneralLLM do workflow real (gpt-4.1-mini).
OPENAI_API_KEY=sua_chave_openai

# Obrigatória para gerar a resposta final com o adapter LoRA treinado.
# Use um caminho absoluto para o diretório salvo pelo treinamento.
QWEN_LORA_ADAPTER_PATH=/caminho/absoluto/para/o/adapter-lora

# Opcional: o runtime usa este valor como padrão caso não seja informado.
QWEN_BASE_MODEL=Qwen/Qwen3.5-4B

# Copie para `.env.local` e ajuste conforme o ambiente.

# `false` fala com o FastAPI real via proxy `/api` → localhost:8000.
# `true` (padrão) mantém o mock local com o mesmo ChatResponse.
VITE_USE_MOCK=true

# Só é necessário se a API estiver em outro host/porta e você não usar o proxy
# do Vite. Vazio = caminhos relativos (`/api/chat`).
# VITE_API_BASE_URL=http://localhost:8000
